# Athena environment template — copy to `.env` and fill values.
# NEVER commit real values. Publishable/anon keys are safe in client bundles;
# secret keys must live only in server-side environment.

# --- Supabase (Lovable Cloud provisions these in Lovable projects) ---
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_PROJECT_ID="YOUR-PROJECT-REF"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."          # anon/publishable key
# Server-only. Bypasses RLS. Required by src/integrations/supabase/client.server.ts
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."
# Direct Postgres URL (server-only). Used by migrations / analytics tooling.
SUPABASE_DB_URL="postgresql://postgres:PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres"

# --- Client-visible copies (Vite exposes only VITE_*) ---
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_PROJECT_ID="YOUR-PROJECT-REF"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# --- Lovable AI Gateway (routes GPT/Gemini/etc; used by ai-gateway.server.ts) ---
# Server-only. Required for Athena conversation, reflection, pair reasoning,
# TTS (/api/tts) and STT (/api/stt).
LOVABLE_API_KEY="lv_..."
